{
  "uid": "satark-slo",
  "title": "Satark / SLOs and error budget",
  "tags": [
    "satark",
    "slo"
  ],
  "description": "Gateway API availability (99.5%) and latency (95% under 800 ms) over 30 days. Built on slo:* recording rules.",
