# {{ ansible_managed }}
# Satark edge: TCP passthrough by SNI to the cluster gateway over WireGuard.

global
    log /dev/log local0
    maxconn {{ haproxy_edge_maxconn }}
    user haproxy
    group haproxy
    daemon
    stats socket /run/haproxy/admin.sock mode 660 level admin

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    timeout connect {{ haproxy_edge_timeout_connect }}
    timeout client  {{ haproxy_edge_timeout_client }}
    timeout server  {{ haproxy_edge_timeout_server }}

frontend https_in
    bind :{{ haproxy_edge_https_port }}
    mode tcp
    tcp-request inspect-delay 5s
    tcp-request content accept if { req_ssl_hello_type 1 }
    acl allowed_sni req_ssl_sni -i {{ haproxy_edge_allowed_sni | join(' ') }}
    tcp-request content reject unless allowed_sni
    default_backend cluster_https

backend cluster_https
    mode tcp
    server gateway {{ haproxy_edge_backend_ip }}:443 check inter 10s fall 3 rise 2{% if haproxy_edge_send_proxy %} send-proxy-v2{% endif %}


frontend http_in
    bind :{{ haproxy_edge_http_port }}
    mode tcp
    default_backend cluster_http

backend cluster_http
    mode tcp
    server gateway {{ haproxy_edge_backend_ip }}:80 check inter 10s fall 3 rise 2{% if haproxy_edge_send_proxy %} send-proxy-v2{% endif %}


# Local-only stats and health endpoint (not opened in the security group).
frontend stats
    mode http
    bind 127.0.0.1:{{ haproxy_edge_stats_port }}
    stats enable
    stats uri /stats
    http-request return status 200 content-type text/plain string ok if { path /healthz }
