# {{ ansible_managed }}
log_path = "/var/log/runsc/%ID%/shim.log"
log_level = "{{ 'debug' if gvisor_debug else 'info' }}"
[runsc_config]
  platform = "{{ gvisor_platform }}"
  network = "{{ gvisor_network }}"
{% if gvisor_debug %}
  debug = "true"
  debug-log = "/var/log/runsc/%ID%/gvisor.%COMMAND%.log"
{% endif %}
